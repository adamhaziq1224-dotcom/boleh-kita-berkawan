    <form id="interests-form" action="https://formspree.io/f/mdekoyzp" method="POST">
      <input type="hidden" name="answer" value="Ya">
      <label for="games">kau main game ker ?</label>
      <input id="games" name="game" type="text" placeholder="Kalau main, game apa?" maxlength="300" required>
      <label for="hobbies">apa hobi yang kau selalu buat ?</label>
      <input id="hobbies" name="hobi" type="text" placeholder="Ceritalah hobi kau..." maxlength="500" required>
      <label for="nasyid">kau suka dengar Lagu Nasyid tak ?</label>
      <input id="nasyid" name="lagu_nasyid" type="text" placeholder="Suka atau tak, lagu apa?" maxlength="300" required>
      <button class="button confirm" type="submit">terima kasih <span aria-hidden="true">♥</span></button>
      <p id="confirmation" class="confirmation" role="status" hidden></p>
      <p class="footnote">aku terima segala jawapan yang kau bagi dengan hati terbuka</p>
    </form>
  </main>
<script>
const noButton = document.querySelector('.no');
if (noButton) {
  let position = -1;
  let remaining = [];
  let bounce;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const move = () => {
    // Visit all six destinations in random order before starting another round.
    if (remaining.length === 0) remaining = [0, 1, 2, 3, 4, 5];
    const choices = remaining.filter((value) => value !== position);
    position = choices[Math.floor(Math.random() * choices.length)];
    remaining.splice(remaining.indexOf(position), 1);
    noButton.dataset.position = String(position);
    if (bounce) bounce.cancel();
    if (!reducedMotion.matches) {
      bounce = noButton.animate([
        { transform: 'scale(.75) rotate(-9deg)', offset: 0 },
        { transform: 'scale(1.06) rotate(7deg)', offset: .45 },
        { transform: 'scale(.97) rotate(-3deg)', offset: .75 },
        { transform: 'scale(1) rotate(0deg)', offset: 1 }
      ], { duration: 360, easing: 'ease-out' });
    }
  };
  noButton.addEventListener('pointerdown', (event) => {
    event.preventDefault();
    move();
  });
  // Keyboard and assistive-technology activation also advance one position.
  noButton.addEventListener('click', (event) => {
    event.preventDefault();
    if (event.detail === 0) move();
  });
}

const form = document.querySelector('#interests-form');
if (form) {
  const answerInputs = [...form.querySelectorAll('input[type="text"]')];
  answerInputs.forEach((input) => input.addEventListener('input', () => input.setCustomValidity('')));
  const submitButton = form.querySelector('button[type="submit"]');
  let sending = false;
  let sent = false;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (sending || sent || !form.reportValidity()) return;
    for (const input of answerInputs) {
      if (!input.value.trim()) {
        input.setCustomValidity('Isi jawapan kau dulu ya.');
        input.reportValidity();
        return;
      }
    }
    const confirmation = document.querySelector('#confirmation');
    const data = new FormData(form);
    answerInputs.forEach((input) => data.set(input.name, input.value.trim()));
    sending = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Sedang menghantar…';
    confirmation.textContent = 'Sedang menghantar pilihan awak…';
    confirmation.hidden = false;
    form.setAttribute('aria-busy', 'true');
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 20000);
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
        signal: controller.signal
      });
      if (!response.ok) throw new Error('Submission failed');
      sent = true;
      confirmation.textContent = 'Terima kasih awak disana.';
      submitButton.textContent = 'Dah hantar ♥';
      form.querySelectorAll('input').forEach((input) => { input.disabled = true; });
    } catch (error) {
      confirmation.textContent = error.name === 'AbortError'
        ? 'Sambungan mengambil masa terlalu lama. Kami belum dapat pastikan pilihan awak diterima. Cuba lagi sebentar ya.'
        : 'Kami belum dapat pastikan pilihan awak diterima. Semak sambungan internet dan cuba lagi ya.';
      submitButton.disabled = false;
      submitButton.textContent = 'Cuba lagi ♥';
    } finally {
      clearTimeout(timeout);
      sending = false;
      form.removeAttribute('aria-busy');
    }
  });
}

const views = {
  '#letter-1': document.querySelector('#letter-1'),
  '#letter-2': document.querySelector('#letter-2'),
  '#question': document.querySelector('#question-page'),
  '#plan': document.querySelector('#plan-page')
};
let activeView;
let pageAnimation;
function showPage() {
  const route = Object.hasOwn(views, window.location.hash) ? window.location.hash : '#letter-1';
  const next = views[route];
  const previous = activeView;
  if (pageAnimation) pageAnimation.cancel();
  Object.values(views).forEach((view) => { view.hidden = view !== next; });
  activeView = next;
  document.title = route === '#plan' ? 'kau selalu buat apa' : 'Sepucuk surat untuk awak';
  if (previous && previous !== next && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const forward = Object.values(views).indexOf(next) > Object.values(views).indexOf(previous);
    pageAnimation = next.animate([
      { opacity: 0, transform: `perspective(1200px) translateX(${forward ? '45px' : '-45px'}) rotateY(${forward ? '-35deg' : '35deg'})`, transformOrigin: 'left center' },
      { opacity: 1, transform: 'perspective(1200px) translateX(0) rotateY(0deg)', transformOrigin: 'left center' }
    ], { duration: 650, easing: 'cubic-bezier(.16, 1, .3, 1)' });
  }
  const heading = next.querySelector('h1');
  heading.setAttribute('tabindex', '-1');
  heading.focus({ preventScroll: true });
  window.scrollTo(0, 0);
}
window.addEventListener('hashchange', showPage);
showPage();
</script>
